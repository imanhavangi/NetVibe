# PostgreSQL Configuration
POSTGRES_USER=netvibe_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_RANDOM_64_CHAR_PASSWORD
POSTGRES_DB=netvibe_analytics

# Redis Configuration (no password by default, but you can add REDIS_PASSWORD if needed)
REDIS_URL=redis://redis_cache:6379/0

# Database Connection URL (will be constructed from above variables)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres_db/${POSTGRES_DB}

# Application Settings
SUBMISSION_RATE_LIMIT=600

# Nginx Port Mapping (external:internal)
NGINX_PORT=8008

# Security Note:
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate secure random passwords using: python3 generate_secrets.py
# 3. Never commit .env file to version control
# 4. Use strong, random passwords in production (64+ characters recommended)
